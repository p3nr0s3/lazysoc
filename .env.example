# LazySOC Environment Configuration
# Multiple keys can be comma-separated for rotation pools

# VirusTotal API Keys (comma-separated for key rotation)
VIRUSTOTAL_API_KEYS=

# AbuseIPDB API Keys (comma-separated for key rotation)
ABUSEIPDB_API_KEYS=

# NIST NVD 2.0 API Key (Optional: boosts rate limit from 5 to 50 req / 30s)
NVD_API_KEY=

# Cache Time-To-Live in hours (default: 24)
CACHE_TTL_HOURS=24

# Auto-throttle wait timeout in seconds when all keys are rate-limited (default: 65)
RATE_LIMIT_COOLDOWN_SECONDS=65

# Security lock: set to false in production to prevent web UI modification of API keys
ALLOW_KEY_MANAGEMENT=false

# Login (HTTP Basic Auth) for every page and API call except /healthz. Leave empty to disable.
# Strongly recommended for any deployment reachable from the internet (e.g. Render); use HTTPS.
LAZYSOC_AUTH_USER=
LAZYSOC_AUTH_PASSWORD=
# Alternative to the plain password: SHA-256 hex digest of it
# LAZYSOC_AUTH_PASSWORD_SHA256=

# Critical tools watchlist (default: data/watchlist.json, git-ignored). See watchlist.example.json
# WATCHLIST_FILE=

# Allow uploading the watchlist from the web UI (set false on shared instances: the app has no login)
ALLOW_WATCHLIST_UPLOAD=true

# AI summaries in Cyber Feeds (per article and per period). Only public article text is sent.
AI_SUMMARY_ENABLED=true
AI_DEFAULT_PROVIDER=claude          # claude | local

# Claude API
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-opus-5-5
AI_SUMMARY_EFFORT=low

# Local LLM via an OpenAI-compatible server, e.g. Ollama (http://localhost:11434/v1) or LM Studio (http://localhost:1234/v1)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_SECONDS=300
